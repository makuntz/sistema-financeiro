generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  income
  expense
}

enum WorkspaceRole {
  owner
  admin
  member
  viewer
}

model User {
  id               String   @id @db.Uuid
  name             String
  email            String
  normalizedEmail  String   @unique @map("normalized_email")
  passwordHash     String   @map("password_hash")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  memberships           WorkspaceMember[]
  sessions              AuthSession[]
  createdWorkspaces     Workspace[] @relation("WorkspaceCreatedBy")
  invitationsSent       WorkspaceInvitation[] @relation("InvitationInvitedBy")
  invitationsAccepted   WorkspaceInvitation[] @relation("InvitationAcceptedBy")
  auditLogs             AuditLog[]
  createdPlans          MonthlyPlan[] @relation("PlanCreatedBy")
  updatedPlans          MonthlyPlan[] @relation("PlanUpdatedBy")
  createdLedgerEntries  LedgerEntry[] @relation("LedgerCreatedBy")
  updatedLedgerEntries  LedgerEntry[] @relation("LedgerUpdatedBy")
  voidedLedgerEntries   LedgerEntry[] @relation("LedgerVoidedBy")

  @@map("users")
}

model Workspace {
  id              String   @id @db.Uuid
  name            String
  currency        String   @default("BRL")
  locale          String   @default("pt-BR")
  timezone        String   @default("America/Sao_Paulo")
  isActive        Boolean  @default(true) @map("is_active")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  createdBy       User     @relation("WorkspaceCreatedBy", fields: [createdByUserId], references: [id])
  members         WorkspaceMember[]
  categories      Category[]
  subcategories   Subcategory[]
  invitations     WorkspaceInvitation[]
  auditLogs       AuditLog[]
  monthlyPlans    MonthlyPlan[]
  monthlyPlanItems MonthlyPlanItem[]
  ledgerEntries   LedgerEntry[]

  @@index([createdByUserId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  isActive    Boolean       @default(true) @map("is_active")
  joinedAt    DateTime      @default(now()) @map("joined_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace      Workspace      @relation(fields: [workspaceId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  ledgerEntries  LedgerEntry[]  @relation("LedgerAttributedMember")

  @@unique([id, workspaceId])
  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model AuthSession {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user             User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("auth_sessions")
}

model WorkspaceInvitation {
  id               String        @id @db.Uuid
  workspaceId      String        @map("workspace_id") @db.Uuid
  invitedEmail     String        @map("invited_email")
  normalizedEmail  String        @map("normalized_email")
  role             WorkspaceRole
  tokenHash        String        @unique @map("token_hash")
  invitedByUserId  String        @map("invited_by_user_id") @db.Uuid
  expiresAt        DateTime      @map("expires_at")
  acceptedAt       DateTime?     @map("accepted_at")
  acceptedByUserId String?       @map("accepted_by_user_id") @db.Uuid
  declinedAt       DateTime?     @map("declined_at")
  revokedAt        DateTime?     @map("revoked_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  workspace        Workspace     @relation(fields: [workspaceId], references: [id])
  invitedBy        User          @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id])
  acceptedBy       User?         @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id])

  @@index([workspaceId])
  @@index([normalizedEmail])
  @@index([tokenHash])
  @@map("workspace_invitations")
}

model AuditLog {
  id          String   @id @db.Uuid
  name        String
  actorUserId String?  @map("actor_user_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  payload     Json
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  actor       User?      @relation(fields: [actorUserId], references: [id])
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, occurredAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

model Category {
  id             String       @id @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  name           String
  normalizedName String       @map("normalized_name")
  type           CategoryType
  color          String
  icon           String
  order          Int          @default(0)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  workspace      Workspace    @relation(fields: [workspaceId], references: [id])
  subcategories  Subcategory[]

  @@unique([workspaceId, type, normalizedName])
  @@index([workspaceId, isActive])
  @@map("categories")
}

model Subcategory {
  id             String   @id @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  name           String
  normalizedName String   @map("normalized_name")
  order          Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  category       Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  planItems      MonthlyPlanItem[] @relation("PlanItemSubcategory")
  ledgerEntries  LedgerEntry[] @relation("LedgerSubcategory")

  @@unique([id, workspaceId])
  @@unique([workspaceId, categoryId, normalizedName])
  @@index([workspaceId])
  @@index([categoryId])
  @@index([workspaceId, isActive])
  @@index([categoryId, isActive])
  @@map("subcategories")
}

model MonthlyPlan {
  id              String   @id @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  year            Int
  month           Int
  version         Int      @default(1)
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  updatedByUserId String   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy       User      @relation("PlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy       User      @relation("PlanUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  items           MonthlyPlanItem[]

  @@unique([workspaceId, year, month])
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@map("monthly_plans")
}

model MonthlyPlanItem {
  id                   String   @id @db.Uuid
  workspaceId          String   @map("workspace_id") @db.Uuid
  monthlyPlanId        String   @map("monthly_plan_id") @db.Uuid
  subcategoryId        String   @map("subcategory_id") @db.Uuid
  plannedAmountInCents BigInt   @map("planned_amount_in_cents")

  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  monthlyPlan   MonthlyPlan  @relation(fields: [monthlyPlanId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  subcategory   Subcategory  @relation("PlanItemSubcategory", fields: [subcategoryId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([monthlyPlanId, subcategoryId])
  @@index([workspaceId])
  @@index([monthlyPlanId])
  @@index([subcategoryId])
  @@map("monthly_plan_items")
}

model LedgerEntry {
  id                  String       @id @db.Uuid
  workspaceId         String       @map("workspace_id") @db.Uuid
  subcategoryId       String       @map("subcategory_id") @db.Uuid
  categoryId          String       @map("category_id") @db.Uuid
  kind                CategoryType
  description         String
  notes               String?
  amountInCents       BigInt       @map("amount_in_cents")
  occurredOn          DateTime     @map("occurred_on") @db.Date
  competenceYear      Int          @map("competence_year")
  competenceMonth     Int          @map("competence_month")
  attributedMemberId  String?      @map("attributed_member_id") @db.Uuid
  createdByUserId     String       @map("created_by_user_id") @db.Uuid
  updatedByUserId     String       @map("updated_by_user_id") @db.Uuid
  version             Int          @default(1)
  voidedAt            DateTime?    @map("voided_at")
  voidedByUserId      String?      @map("voided_by_user_id") @db.Uuid
  voidReason          String?      @map("void_reason")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  subcategory        Subcategory     @relation("LedgerSubcategory", fields: [subcategoryId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  attributedMember   WorkspaceMember? @relation("LedgerAttributedMember", fields: [attributedMemberId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdBy          User            @relation("LedgerCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy          User            @relation("LedgerUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  voidedBy           User?           @relation("LedgerVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, competenceYear, competenceMonth])
  @@index([workspaceId, occurredOn])
  @@index([workspaceId, subcategoryId])
  @@index([workspaceId, kind])
  @@index([workspaceId, attributedMemberId])
  @@index([workspaceId, voidedAt])
  @@index([createdByUserId])
  @@index([updatedAt])
  @@map("ledger_entries")
}
