{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "CI",
    "NODE_ENV",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "JWT_SECRET",
    "ACCESS_TOKEN_TTL_SECONDS",
    "REFRESH_TOKEN_TTL_DAYS",
    "PASSWORD_HASH_MEMORY_COST",
    "PASSWORD_HASH_TIME_COST",
    "PASSWORD_HASH_PARALLELISM",
    "WEB_URL",
    "API_URL",
    "MOBILE_API_URL",
    "PORT",
    "S3_ENDPOINT",
    "S3_PUBLIC_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "NEXT_PUBLIC_API_URL",
    "HOST",
    "RECEIPT_EXTRACTOR_PROVIDER",
    "RECEIPT_PROCESSING_MAX_ATTEMPTS",
    "RECEIPT_PROCESSING_TIMEOUT_SECONDS",
    "RECEIPT_IMAGE_MAX_SIZE_BYTES",
    "RECEIPT_IMAGE_MAX_COUNT",
    "RECEIPT_ALLOW_FAKE_IN_PRODUCTION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
