{
  "expo": {
    "name": "PP Planning",
    "slug": "pp-planning",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ppplanning",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ppplanning.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F766E"
      },
      "package": "com.ppplanning.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir acesso à câmera para escanear notas fiscais."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acesso à galeria para importar notas fiscais."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
