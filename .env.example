NODE_ENV=development
PORT=3333

# PostgreSQL
DATABASE_URL=postgresql://pp_planning:pp_planning_dev@localhost:5433/pp_planning?schema=public
TEST_DATABASE_URL=postgresql://pp_planning:pp_planning_dev@localhost:5433/pp_planning_test?schema=public
POSTGRES_PORT=5433

# Application URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:3333
MOBILE_API_URL=http://localhost:3333

# Auth (development only — replace in production)
JWT_SECRET=change-me-to-a-long-random-secret-in-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Argon2id (dev defaults — OWASP-inspired memory cost in KiB)
PASSWORD_HASH_MEMORY_COST=19456
PASSWORD_HASH_TIME_COST=2
PASSWORD_HASH_PARALLELISM=1

# S3-compatible storage (MinIO local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pp-planning
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Receipt capture (Etapa 6) — somente fake nesta etapa
RECEIPT_EXTRACTOR_PROVIDER=fake
RECEIPT_PROCESSING_MAX_ATTEMPTS=3
RECEIPT_PROCESSING_TIMEOUT_SECONDS=60
RECEIPT_IMAGE_MAX_SIZE_BYTES=10485760
RECEIPT_IMAGE_MAX_COUNT=3
RECEIPT_ALLOW_FAKE_IN_PRODUCTION=false
HOST=0.0.0.0
