NODE_ENV=development
PORT=3333

# PostgreSQL
DATABASE_URL=postgresql://pp_planning:pp_planning_dev@localhost:5433/pp_planning?schema=public
POSTGRES_PORT=5433

# Application URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:3333
MOBILE_API_URL=http://localhost:3333

# Auth (development only — replace in production)
JWT_SECRET=change-me-to-a-long-random-secret-in-production

# S3-compatible storage (MinIO local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pp-planning
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
